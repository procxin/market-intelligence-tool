# ============================================================
# Market Intelligence Tool — Configuration
# ============================================================
# Copy this file to .env and fill in your keys.
# All keys are optional — the app degrades gracefully.
# ============================================================

# Access password (leave empty for open access during local dev)
APP_PASSWORD=

# Financial Modeling Prep (https://financialmodelingprep.com)
# Free tier: 250 req/day — covers fundamentals, news, earnings
FMP_API_KEY=

# Finnhub (https://finnhub.io)
# Free tier: 60 req/min — covers quotes, news, sentiment, calendar
FINNHUB_API_KEY=

# Alpha Vantage (https://www.alphavantage.co)
# Free tier: 25 req/day — covers FX, commodities, technicals
ALPHA_VANTAGE_API_KEY=

# FRED (https://fred.stlouisfed.org)
# Free: unlimited — covers macro, rates, liquidity, spreads
FRED_API_KEY=

# CoinGecko (https://www.coingecko.com/en/api)
# Free tier: 10-30 req/min — covers crypto prices, on-chain proxies
COINGECKO_API_KEY=

# NewsData.io (https://newsdata.io)
# Free tier: 200 req/day — covers global news with sentiment
NEWSDATA_API_KEY=

# Polygon.io (https://polygon.io) — Optional premium
POLYGON_API_KEY=
